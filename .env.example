# Modelo das variáveis de ambiente.
# Copie para .env.local (local) e cadastre na Vercel (Settings → Environment Variables,
# Production e Preview). Nunca coloque valores secretos neste arquivo: ele vai para o GitHub.

# Google Analytics 4 (opcional; sem ele o GA não é carregado)
NEXT_PUBLIC_GA_ID=

# Formulário /hotline → planilha de leads (Google Apps Script). Secretos.
HOTLINE_SCRIPT_URL=
HOTLINE_TOKEN=

# Aviso por e-mail de novo lead (Resend). A chave é secreta.
RESEND_API_KEY=
# Destinatários do aviso, separados por vírgula
HOTLINE_EMAIL_TO=franciscojbo@gmail.com,henrique@benedini.net.br,gabriel+benforms@gcgtech.com.br
